<?php

// Ensure a session token exists before rendering the form.
if (!isset($_SESSION['session_token'])) {
    generateSessionToken();
}

if (isset($_GET['Change'])) {

    // Validate the anti-CSRF token before processing the request.
    $token = isset($_GET['user_token']) ? $_GET['user_token'] : '';
    checkToken($token, $_SESSION['session_token'], 'index.php');

    $pass_new  = $_GET['password_new'];
    $pass_conf = $_GET['password_conf'];

    if ($pass_new == $pass_conf) {

        $pass_new = mysqli_real_escape_string(
            $GLOBALS["___mysqli_ston"],
            $pass_new
        );

        $pass_new = md5($pass_new);

        $current_user = dvwaCurrentUser();
        $insert = "UPDATE `users` SET password = '$pass_new' WHERE user = '" . $current_user . "';";

        $result = mysqli_query($GLOBALS["___mysqli_ston"], $insert)
            or die('<pre>' . mysqli_error($GLOBALS["___mysqli_ston"]) . '</pre>');

        $html .= "<pre>Password Changed.</pre>";

    } else {
        $html .= "<pre>Passwords did not match.</pre>";
    }

    mysqli_close($GLOBALS["___mysqli_ston"]);

    // Rotate the token after processing the request.
    generateSessionToken();
}

?>